node_modules/
.next/
out/
build/
dist/

# Environment — never commit real credentials.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Tooling caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.DS_Store
coverage/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
.vercel
# Vercel's `vercel link` appends `.env*`, which would also hide the committed
# `.env.example`. The explicit list above already covers the real ones, so the
# blanket rule is narrowed to the local files Vercel actually writes.
.env*.local
